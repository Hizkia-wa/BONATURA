# BONATURA Backend Environment Variables

# Application Server
PORT=8080
APP_ENV=development

# Database Connection (PostgreSQL Lokal)
# Menggunakan 127.0.0.1 (IPv4) untuk menghindari isu SASL IPv6 [::1] di Windows
DATABASE_URL=postgres://postgres:BonaturaLocal2026!@127.0.0.1:5432/bonatura?sslmode=disable

# Supabase Configurations (Opsional jika nanti di-deploy ke cloud)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
JWT_SECRET=bonatura-cultural-heritage-secret-key-2026

# Frontend Next.js URL (CORS)
FRONTEND_URL=http://localhost:3000
